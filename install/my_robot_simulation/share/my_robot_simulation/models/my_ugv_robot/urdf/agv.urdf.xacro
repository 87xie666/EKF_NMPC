<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_agv">

  <!-- ================== 材质与颜色定义 ================== -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>

  <!-- ================== 1. 机器人基础投影点 ================== -->
  <!-- 必须有 base_footprint 才能让 Nav2 正确计算地面投影 -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ================== 2. 底盘主体 (Base Link) ================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.14" iyz="0" izz="0.2"/>
    </inertial>
  </link>

  <!-- ================== 3. 驱动轮宏定义 ================== -->
  <!-- 使用 xacro 宏定义避免左右轮代码重复 -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="0.1" length="0.05"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <!-- 简化的圆柱体转动惯量 -->
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.005"/>
      </inertial>
    </link>

    <!-- continuous 类型关节，允许车轮无限旋转 -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- 将车轮放倒 (绕X轴旋转-90度) -->
      <origin xyz="0.1 ${y_offset} -0.05" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- 实例化左右驱动轮 -->
  <xacro:wheel prefix="left" y_offset="0.175"/>
  <xacro:wheel prefix="right" y_offset="-0.175"/>

  <!-- ================== 4. 后置万向轮/支撑轮 ================== -->
  <!-- 如果没有这个轮子，小车底盘会直接拖在地上 -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.15 0 -0.055" rpy="0 0 0"/>
  </joint>

  <!-- 极其关键：将万向轮在 Gazebo 中的摩擦力设为 0，让其纯滑动，避免干扰控制算法 -->
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ================== 5. 激光雷达 (LiDAR) ================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- 安装在车头正中央上方 -->
    <origin xyz="0.15 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- ================== 6. Gazebo 仿真插件 ================== -->
  
  <!-- 差速驱动插件：你的 NMPC 发出的 cmd_vel 就是由它转换为轮子转速的 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
      <!-- 必须与上面的 joint 名称严格一致 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      
      <!-- 里程计与坐标系发布配置 -->
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 激光雷达感知插件：提供 /scan 话题，供 Nav2 生成局部避障代价地图 -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <pose>0 0 0 0 0 0</pose>
      <!-- 设为 true 可以在 Gazebo 里看到蓝色的雷达射线 -->
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>