<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="narrow_pipe">
    <!-- 设为 static，这样管道才不会受重力影响掉下去或者被小车撞飞 -->
    <static>true</static>
    <link name="pipe_link">
      
      <!-- ================= 1. 湿滑底面 (极低摩擦力) ================= -->
      <collision name="floor_collision">
        <!-- Z=0.01 让底板贴近地面 -->
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box><size>20.0 1.2 0.02</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.15</mu>
              <mu2>0.10</mu2>
              <fdir1>1 0 0</fdir1>
              <slip1>0.2</slip1>
              <slip2>0.3</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="floor_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box><size>20.0 1.2 0.02</size></box>
        </geometry>
        <!-- 底板涂成浅灰色 -->
        <material><ambient>0.6 0.6 0.6 1</ambient></material>
      </visual>

      <!-- ================= 2. 左侧管壁 ================= -->
      <collision name="left_wall_collision">
        <!-- 向左平移 (1.2/2 + 墙厚0.1/2 = 0.65)，向上抬起 0.25 -->
        <pose>0 0.65 0.25 0 0 0</pose>
        <geometry>
          <box><size>20.0 0.1 0.5</size></box>
        </geometry>
      </collision>
      <visual name="left_wall_visual">
        <pose>0 0.65 0.25 0 0 0</pose>
        <geometry>
          <box><size>20.0 0.1 0.5</size></box>
        </geometry>
        <!-- 墙壁涂成深灰色 -->
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>

      <!-- ================= 3. 右侧管壁 ================= -->
      <collision name="right_wall_collision">
        <!-- 向右平移 -0.65，向上抬起 0.25 -->
        <pose>0 -0.65 0.25 0 0 0</pose>
        <geometry>
          <box><size>20.0 0.1 0.5</size></box>
        </geometry>
      </collision>
      <visual name="right_wall_visual">
        <pose>0 -0.65 0.25 0 0 0</pose>
        <geometry>
          <box><size>20.0 0.1 0.5</size></box>
        </geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material>
      </visual>

    </link>
  </model>
</sdf>